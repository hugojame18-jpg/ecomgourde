# URL publique du site — utilisée pour les URL canoniques, le sitemap
# et les images de partage.
NEXT_PUBLIC_SITE_URL=https://sugar.example

# Boutique Shopify qui encaisse les commandes.
# Le bouton « Commander » redirige vers https://<ce domaine>/cart/...
# Aucun jeton d'API n'est nécessaire. Remplace cette valeur le jour où tu
# branches un vrai domaine sur la boutique Shopify.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=jdwqx1-bw.myshopify.com
